{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.dev.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    /* Solo `vite/client`: el modo mock corre en el NAVEGADOR, así que `node` no
       tiene nada que hacer acá. Si alguien importa algo de node en `dev/`, que
       falle en compilación y no en la pantalla. */
    "types": ["vite/client"],
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },

    /* Bundler mode · igual que la app: las pruebas importan los mismos módulos */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Las mismas flags estrictas que la app. Una prueba con el tipado relajado
       afirma sobre una forma que el código de producción no tiene: es
       precisamente la clase de prueba que pasa mientras el código está mal. */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["dev"]
}
