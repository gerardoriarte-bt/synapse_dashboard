# La base de la API. Sin esto el cliente pega contra /api/v1 del mismo origen,
# que es lo que sirve con el proxy de Vite en desarrollo.
VITE_API_URL=/api/v1

# La base del servicio de ACCESO, que es otro despliegue: `synapse-api-go`
# publica el login bajo su propio /api/v1. Sin esto cae a VITE_API_URL, que es
# lo correcto si los dos quedan detrás del mismo origen.
VITE_AUTH_URL=/api/v1
