+package services
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+
+	"synapse-api/internal/core/ports"
+)
+
+// ── POR QUÉ UN SERVICIO APARTE Y NO UN MÉTODO EN `ddConfigService` ───────────
+//
+// `GetBlocks` vive en el servicio de configuración y lo natural sería poner
+// `GetPlots` al lado. **Agregar el repositorio a `NewDDConfigService` cambia su
+// firma, y ocho archivos de tests la construyen** — ese cambio se propaga a
+// todos ellos sin aportar nada.
+//
+// El repertorio no necesita ninguna de las diez dependencias de aquel servicio:
+// es una tabla global, sin tenant y sin rol. Un servicio propio con un solo
+// repositorio dice eso en su forma.
+type DDPlotService struct {
+	repo ports.DDPlotRepository
+}
+
+func NewDDPlotService(repo ports.DDPlotRepository) *DDPlotService {
+	return &DDPlotService{repo: repo}
+}
+
+// PlotRule es lo que viaja: las tres columnas jsonb ya desempaquetadas.
+//
+// **El desempaquetado va acá y no en el handler** por la misma razón que
+// `BlockRulesFromDomain`: un jsonb mal formado es un error del seed y tiene que
+// salir con el id del gráfico que lo tiene, no como un 500 sin nombre.
+type PlotRule struct {
+	ID           string        `json:"id"`
+	Name         string        `json:"name"`
+	Shapes       []string      `json:"shapes"`
+	SupportsBand bool          `json:"supports_band"`
+	Minimums     []PlotMinimum `json:"minimums"`
+	Cap          *PlotCap      `json:"cap"`
+}
+
+type PlotMinimum struct {
+	Shape  string `json:"shape"`
+	When   string `json:"when"`
+	Reason string `json:"reason"`
+}
+
+type PlotCap struct {
+	When   string `json:"when"`
+	Reason string `json:"reason"`
+}
+
+func (s *DDPlotService) GetPlots(ctx context.Context) ([]PlotRule, error) {
+	plots, err := s.repo.ListAll(ctx)
+	if err != nil {
+		return nil, err
+	}
+	out := make([]PlotRule, 0, len(plots))
+	for _, p := range plots {
+		var shapes []string
+		if err := json.Unmarshal(p.Shapes, &shapes); err != nil {
+			return nil, fmt.Errorf("plot %s shapes: %w", p.PlotID, err)
+		}
+		// **`minimums` sale como lista vacía y nunca como `null`.** Vacío
+		// significa «este gráfico no exige un mínimo», que es distinto de «no se
+		// sabe»; un `null` en el cable obliga a cada consumidor a distinguir los
+		// dos casos y el día que alguien no lo haga, un gráfico sin mínimo se lee
+		// como uno sin verificar.
+		minimums := []PlotMinimum{}
+		if len(p.Minimums) > 0 && string(p.Minimums) != "null" {
+			if err := json.Unmarshal(p.Minimums, &minimums); err != nil {
+				return nil, fmt.Errorf("plot %s minimums: %w", p.PlotID, err)
+			}
+		}
+		var cap *PlotCap
+		if len(p.Cap) > 0 && string(p.Cap) != "null" {
+			cap = &PlotCap{}
+			if err := json.Unmarshal(p.Cap, cap); err != nil {
+				return nil, fmt.Errorf("plot %s cap: %w", p.PlotID, err)
+			}
+		}
+		out = append(out, PlotRule{
+			ID:           p.PlotID,
+			Name:         p.Name,
+			Shapes:       shapes,
+			SupportsBand: p.SupportsBand,
+			Minimums:     minimums,
+			Cap:          cap,
+		})
+	}
+	return out, nil
+}
