+		{"FILA": "Meta", "COLUMNA": "2026-09", "V": 14000.0},
+	}
+	res, err := materialize.Materialize(spec.Shape, rows, spec.Options)
+	if err != nil {
+		t.Fatal(err)
+	}
+	filas, _ := res.Value["rows"].([]string)
+	columnas, _ := res.Value["columns"].([]string)
+	if len(filas) != 2 || len(columnas) != 2 {
+		t.Fatalf("matriz %dx%d, se esperaba 2x2", len(filas), len(columnas))
+	}
+	celdas, _ := res.Value["cells"].([][]any)
+	if celdas[0][1] != 34000.0 {
