+package dashboard_test
+
+import (
+	"strings"
+	"testing"
+
+	"synapse-api/internal/core/dashboard/materialize"
+	sfspec "synapse-api/internal/core/dashboard/snowflake"
+)
+
+// Las tres métricas nuevas de 2026-09-30 · escritas por el equipo de front.
+//
+// ── QUÉ VERIFICA ESTO, Y POR QUÉ NO ALCANZA CON QUE COMPILE ──────────────────
+//
+// El `BuildSQL` de una métrica y el transformador de su forma se comunican por
+// los NOMBRES DE LAS COLUMNAS, y nada los ata: si el SELECT dice `AS etiqueta`
+// donde el transformador lee `label`, el compilador no dice nada, la consulta
+// corre, y `Materialize` devuelve `ErrInvalidRow` o —peor— un valor con menos
+// filas de las que llegaron.
+//
+// Por eso el fixture de cada prueba es **la fila que ese SELECT produce**, no
+// una genérica: los alias se copian del SQL, y si alguien los cambia sin tocar
+// el transformador, esto se pone rojo.
+//
+// ── LAS CLAVES VAN EN MAYÚSCULA, Y ES A PROPÓSITO ────────────────────────────
+//
+// Snowflake devuelve los alias sin comillas en MAYÚSCULA, así que eso es lo que
+// llega al transformador. `lookup` prueba exacto, mayúscula y minúscula, de modo
+// que funciona igual — pero el fixture imita lo que pasa de verdad. Un fixture
+// en minúscula probaría un camino que la producción no recorre.
+
+// aliasDelSQL extrae los `AS <alias>` de una consulta, para cruzar el SQL real
+// contra las claves que el fixture usa. Sin esto la prueba verificaría el
+// fixture contra sí mismo.
+func aliasDelSQL(sql string) map[string]bool {
+	out := map[string]bool{}
+	for _, linea := range strings.Split(sql, "\n") {
+		partes := strings.Split(linea, " AS ")
+		for i := 1; i < len(partes); i++ {
+			alias := strings.TrimRight(strings.Fields(partes[i])[0], ",")
+			out[strings.ToUpper(alias)] = true
+		}
+	}
+	return out
+}
+
+func specDe(t *testing.T, key string) sfspec.MetricSpec {
+	t.Helper()
+	spec, ok := sfspec.MetricRegistry[key]
+	if !ok {
+		t.Fatalf("la métrica %q no está en MetricRegistry: el materializador la daría por BLOCKED", key)
+	}
+	if spec.BuildSQL == nil {
+		t.Fatalf("la métrica %q no tiene BuildSQL", key)
+	}
+	return spec
+}
+
+var tablasDePrueba = sfspec.Tables{EcommFact: "DB.SC.ECOMM", PaidMedia: "DB.SC.PAID"}
+var boundsDePrueba = sfspec.Bounds{Desde: "2026-09-01", Hasta: "2026-10-01"}
+
+func TestPlatformGap_ElSQLYElTransformadorHablanLoMismo(t *testing.T) {
+	spec := specDe(t, "platform_gap")
+	if spec.Shape != materialize.ShapeComparedCategorical {
+		t.Fatalf("shape = %q, se esperaba compared_categorical", spec.Shape)
+	}
+
+	sql := spec.BuildSQL(tablasDePrueba, boundsDePrueba)
+	for _, alias := range []string{"LABEL", "V", "REFERENCE"} {
+		if !aliasDelSQL(sql)[alias] {
+			t.Fatalf("el SQL no produce la columna %q que transformComparedCategorical lee", alias)
+		}
+	}
+
+	// La fila tal como vuelve de Snowflake.
+	rows := []map[string]any{
+		{"LABEL": "Google Ads", "V": 412000.0, "REFERENCE": 318000.0},
+		{"LABEL": "Meta", "V": 148000.0, "REFERENCE": 96000.0},
+	}
+	res, err := materialize.Materialize(spec.Shape, rows, spec.Options)
+	if err != nil {
+		t.Fatal(err)
+	}
+	items, _ := res.Value["items"].([]map[string]any)
+	if len(items) != 2 {
+		t.Fatalf("items = %d, se esperaban 2 · una fila descartada es una plataforma que desaparece del gráfico", len(items))
+	}
+	// **El delta se DERIVA cuando no viene**, y el SQL no lo manda a propósito:
+	// calcularlo en la consulta sería la misma resta escrita dos veces.
+	if d, ok := items[0]["delta"].(float64); !ok || d != 94000 {
+		t.Fatalf("delta = %v, se esperaba 94000 derivado de v - reference", items[0]["delta"])
+	}
+}
+
+func TestPlatformMonthMatrix_ElSQLYElTransformadorHablanLoMismo(t *testing.T) {
+	spec := specDe(t, "platform_month_matrix")
+	if spec.Shape != materialize.ShapeMatrix {
+		t.Fatalf("shape = %q, se esperaba matrix", spec.Shape)
+	}
+
+	sql := spec.BuildSQL(tablasDePrueba, boundsDePrueba)
+	for _, alias := range []string{"FILA", "COLUMNA", "V"} {
+		if !aliasDelSQL(sql)[alias] {
+			t.Fatalf("el SQL no produce la columna %q que transformMatrix lee", alias)
+		}
+	}
+
+	// **`row` y `column` son palabras reservadas**, por eso los alias van en
+	// español. Si alguien los «corrige» a inglés, el SQL falla en Snowflake y
+	// esta prueba no lo ve — pero el cruce de arriba sí ve el cambio de nombre.
+	//
+	// **Y se compara contra el conjunto de alias, no con `strings.Contains`.** La
+	// primera versión usaba `Contains(sql, " AS COLUMN")` y fallaba sobre el SQL
+	// correcto, porque `COLUMNA` empieza con `COLUMN`: una prueba que se pone
+	// roja con el código bien es peor que ninguna.
+	alias := aliasDelSQL(sql)
+	if alias["ROW"] || alias["COLUMN"] {
+		t.Fatal("el SQL usa `row` o `column` como alias, que son palabras reservadas")
+	}
+
+	// **La ventana de doce meses decide el binding**: `periodBindings` detecta
+	// `DATEADD(MONTH, -12` y liga los DOS `?` a `Hasta` en vez de alternar.
+	// Cambiar esa expresión cambia el binding sin que nada avise.
+	if !strings.Contains(strings.ToUpper(sql), "DATEADD(MONTH, -12") {
+		t.Fatal("el SQL perdió `DATEADD(month, -12`: los dos `?` vuelven a alternar Desde/Hasta")
+	}
+
+	rows := []map[string]any{
