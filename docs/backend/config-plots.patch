+package handler
+
+import (
+	"net/http"
+
+	"synapse-api/internal/core/services"
+
+	"github.com/gin-gonic/gin"
+)
+
+type DDPlotHandler struct {
+	svc *services.DDPlotService
+}
+
+func NewDDPlotHandler(svc *services.DDPlotService) *DDPlotHandler {
+	return &DDPlotHandler{svc: svc}
+}
+
+// GetPlots sirve el repertorio entero · `GET /config/plots`.
+//
+// **Global y sin tenant**, igual que `/config/blocks`: qué puede dibujar un
+// gráfico no depende del cliente. Por eso no lee `tenant_id` del contexto ni
+// filtra por rol — un rol que no ve una métrica tampoco ve su panel, y el
+// repertorio no dice nada de métricas.
+//
+// **`data` es el ARREGLO PELADO, sin envolver.** Es lo que hace `GetBlocks` dos
+// archivos más allá, y lo que el front tiene transcripto de medirlo. Envolverlo
+// en `{"plots": [...]}` habría sido más prolijo y habría obligado al front a un
+// segundo adaptador para dos rutas que son la misma cosa. Gana el hermano.
+func (h *DDPlotHandler) GetPlots(c *gin.Context) {
+	rules, err := h.svc.GetPlots(c.Request.Context())
+	if err != nil {
+		SendError(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+	SendSuccess(c, http.StatusOK, rules)
+}
