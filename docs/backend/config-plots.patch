+}
+
+func TestSpendFlow_CadaEtAPAValeLoSuyo(t *testing.T) {
+	spec := specDe(t, "spend_flow")
+	if spec.Shape != materialize.ShapeFlow {
+		t.Fatalf("shape = %q, se esperaba flow", spec.Shape)
+	}
+
+	sql := spec.BuildSQL(tablasDePrueba, boundsDePrueba)
+	for _, alias := range []string{"DESDE", "HACIA", "V", "DESDE_LABEL", "HACIA_LABEL"} {
+		if !aliasDelSQL(sql)[alias] {
+			t.Fatalf("el SQL no produce la columna %q que transformFlow lee", alias)
+		}
+	}
+
+	rows := []map[string]any{
+		{"DESDE": "Google Ads", "HACIA": "total", "V": 412000.0, "DESDE_LABEL": "Google Ads", "HACIA_LABEL": "Total invertido"},
+		{"DESDE": "Meta", "HACIA": "total", "V": 148000.0, "DESDE_LABEL": "Meta", "HACIA_LABEL": "Total invertido"},
+		{"DESDE": "TikTok", "HACIA": "total", "V": 41000.0, "DESDE_LABEL": "TikTok", "HACIA_LABEL": "Total invertido"},
+	}
+	res, err := materialize.Materialize(spec.Shape, rows, spec.Options)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	etapas, _ := res.Value["stages"].([]map[string]any)
+	if len(etapas) != 4 {
+		t.Fatalf("etapas = %d, se esperaban 4 · tres plataformas más el total", len(etapas))
+	}
+
+	// ── LA ASERCIÓN QUE JUSTIFICA LA FORMA DE ESTE FLUJO ─────────────────────
+	//
+	// `transformFlow` calcula el valor de cada etapa como su flujo SALIENTE, y
+	// sólo cae al entrante cuando la etapa no tiene salida. Por eso este flujo NO
+	// es un embudo: en `visitas → sesiones → órdenes` la última etapa mostraría
+	// el valor de la anterior — una cifra correcta en el lugar equivocado.
+	//
+	// Acá cada plataforma tiene una salida con su propia inversión y el total
+	// sólo tiene entradas, así que las cuatro etapas quedan bien por construcción.
+	porID := map[string]float64{}
+	for _, e := range etapas {
+		id, _ := e["id"].(string)
+		v, _ := e["v"].(float64)
+		porID[id] = v
+	}
+	if porID["Google Ads"] != 412000 {
+		t.Fatalf("la etapa de la plataforma vale %v, se esperaba su propia inversión", porID["Google Ads"])
+	}
+	if porID["total"] != 601000 {
+		t.Fatalf("la etapa total vale %v, se esperaba la suma de las tres", porID["total"])
+	}
+}
