@@ -0,0 +1,30 @@
+package repository
+
+import (
+	"context"
+	"fmt"
+
+	"synapse-api/internal/core/domain"
+	"synapse-api/internal/core/ports"
+
+	"gorm.io/gorm"
+)
+
+type postgresDDPlotRepository struct {
+	db *gorm.DB
+}
+
+func NewDDPlotRepository(db *gorm.DB) ports.DDPlotRepository {
+	return &postgresDDPlotRepository{db: db}
+}
+
+// ListAll devuelve el repertorio entero, en el orden del catálogo de diseño.
+// **Ordenado por `sort_order` y no alfabéticamente**: el selector del builder lo
+// pinta en ese orden y es el de §5, que agrupa por familia de gráfico.
+func (r *postgresDDPlotRepository) ListAll(ctx context.Context) ([]domain.DDPlot, error) {
+	var plots []domain.DDPlot
+	if err := r.db.WithContext(ctx).Order("sort_order ASC, plot_id ASC").Find(&plots).Error; err != nil {
+		return nil, fmt.Errorf("DDPlotRepository.ListAll: %w", err)
+	}
+	return plots, nil
+}
