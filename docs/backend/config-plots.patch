+package domain
+
+import "time"
+
+// DDPlot es una entrada del repertorio de gráficos · `SYNAPSE_PLOTS`.
+//
+// **Es una tabla GLOBAL, no por tenant**, igual que `blocks`: qué puede dibujar
+// un gráfico no depende del cliente. Por eso no lleva `tenant_id`.
+//
+// Las tres columnas jsonb guardan lo que el front necesita para decidir sin
+// duplicar la tabla: qué formas acepta, qué mínimos exige y qué techo lo
+// deshabilita. La consumen los tres que validan — el builder, `layout:validate`
+// y el adaptador del front.
+type DDPlot struct {
+	ID     uint   `gorm:"primaryKey" json:"-"`
+	PlotID string `gorm:"column:plot_id;not null;uniqueIndex" json:"id"`
+	Name   string `gorm:"column:name;not null" json:"name"`
+	// Las formas de dato que sabe dibujar, en el idioma del cable
+	// —`scalar`, `time_series`—, igual que `blocks.accepted_shapes`.
+	Shapes JSONRaw `gorm:"type:jsonb;column:shapes;not null" json:"shapes"`
+	// Regla dura 6: `series_with_band` sólo admite gráficos con esto en true.
+	SupportsBand bool `gorm:"column:supports_band;not null;default:false" json:"supports_band"`
+	// Cuántos datos necesita para no engañar, POR FORMA. **Vacío es un valor
+	// legítimo** y no un dato faltante: una cifra es una cifra.
+	Minimums JSONRaw `gorm:"type:jsonb;column:minimums;not null;default:'[]'" json:"minimums"`
+	// El techo que lo deshabilita, con su razón. Nulo cuando no tiene.
+	Cap       JSONRaw   `gorm:"type:jsonb;column:cap" json:"cap,omitempty"`
+	SortOrder int       `gorm:"column:sort_order;not null;default:0" json:"-"`
+	CreatedAt time.Time `json:"created_at"`
+	UpdatedAt time.Time `json:"updated_at"`
+}
+
+func (DDPlot) TableName() string { return "plots" }
