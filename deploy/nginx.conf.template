# Synapse · el front servido como estático, con la API en el MISMO ORIGEN
#
# ── ES UN TEMPLATE, NO UN .conf ────────────────────────────────────────────────
#
# La imagen oficial de nginx corre `envsubst` sobre todo lo que esté en
# `/etc/nginx/templates/*.template` al arrancar y lo escribe en `/etc/nginx/conf.d/`.
# Por eso las variables de abajo se resuelven en el ARRANQUE del contenedor y no
# en el build: el mismo artefacto sirve para pruebas y para producción.
#
#   API_ORIGIN    a dónde va `/api/v1` · ej. http://synapse-api:8080
#   NGINX_PORT    en qué puerto escucha · default 8080
#
# **`envsubst` reemplaza TODO lo que parezca `$var`**, así que las variables de
# nginx que queremos conservar van escapadas como `${DOLLAR}`, y `DOLLAR` se
# define en el compose. Es el modo de falla clásico de este mecanismo: sin eso,
# `$uri` y `$host` se sustituyen por vacío y nginx arranca sirviendo cualquier
# cosa.

# ── EL REGISTRO DE ERRORES DEL NAVEGADOR · ISO 27001 A.8.15 y A.8.16 ─────────
#
# Agregado el 2026-11-09 · brecha 8 de
# `docs/AUDITORIA-2026-11-04-hardening-iso-27001.md`. Hasta ese día un error en
# el navegador de un cliente sólo se sabía si el cliente lo contaba.
#
# **Va al log del contenedor, no a un servicio de terceros.** Mandar errores a
# un SaaS es sacar datos de la casa y pide una decisión que no es del front; el
# log del contenedor ya lo recoge quien opera el despliegue. Una línea JSON por
# error, con `"synapse":"error-del-navegador"` para filtrarla.
#
# Estas dos directivas viven en el contexto `http`: `conf.d/*.conf` se incluye
# ahí, así que van fuera del `server`.
#
# **Sin IP y sin la URL con su query** a propósito: no hacen falta para
# encontrar el defecto y son datos de quien navega. Lo que el front manda está
# en `src/app/errores.ts`.
log_format synapse_errores escape=json
    '{"synapse":"error-del-navegador","hora":"${DOLLAR}time_iso8601",'
    '"via":"${DOLLAR}uri","navegador":"${DOLLAR}http_user_agent",'
    '"cuerpo":"${DOLLAR}request_body"}';

# Un tope para que nadie llene el log a propósito. **Detrás de un balanceador
# todos llegan con la misma IP**, así que el tope es casi del servicio entero:
# 30 por minuto es de sobra para errores reales —el front ya manda como mucho
# diez por carga de página— y poco para inundar.
limit_req_zone ${DOLLAR}binary_remote_addr zone=synapse_errores:1m rate=30r/m;

server {
    listen       ${NGINX_PORT};
    server_name  _;
    root         /usr/share/nginx/html;

    # Sin esto el header dice la versión exacta de nginx.
    server_tokens off;

    # Las cabeceras de seguridad · ver `deploy/seguridad.conf`, que explica por
    # qué se repite en cada `location` con `add_header` propio.
    include /etc/nginx/snippets/synapse-seguridad.conf;

    gzip              on;
    gzip_vary         on;
    gzip_min_length   1024;
    gzip_proxied      any;
    gzip_types        text/plain text/css application/javascript application/json
                      image/svg+xml font/woff2;

    # ── LOS ASSETS · nombre con hash, así que son inmutables ───────────────────
    #
    # Vite les pone un hash de contenido —`index-DP5J1I-v.js`—, así que un cambio
    # cambia el nombre. Cachearlos un año es correcto y es lo que hace que una
    # recarga no vuelva a bajar 888 KB.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        include /etc/nginx/snippets/synapse-seguridad.conf;
        try_files ${DOLLAR}uri =404;
    }

    # ── LA API · MISMO ORIGEN, y por eso no hay CORS que configurar ────────────
    #
    # `src/api/client.ts` resuelve `import.meta.env.VITE_API_URL ?? '/api/v1'`, y
    # Vite lo hornea EN EL BUILD. Sirviendo la API acá, el default ya funciona y
    # **el mismo bundle sirve en cualquier ambiente** — que es lo que evita tener
    # que reconstruir por entorno.
    location /api/v1 {
        proxy_pass         ${API_ORIGIN};
        proxy_http_version 1.1;

        # ── EL UPSTREAM POR HTTPS · SNI Y VERIFICACIÓN ────────────────────────
        #
        # **Las dos van porque los defaults de nginx son los equivocados acá**, y
        # se midió el 2026-10-05 levantando esta imagen contra QA:
        #
        #   docker exec … grep -c 'proxy_ssl_server_name|proxy_ssl_verify'
        #     → 0, o sea los dos en default
        #
        # Y aun así andaba: `GET /api/v1/config/me` devolvía 401 del servicio
        # real, también con el `Host` que va a tener en producción. **Andaba
        # porque el endpoint de QA lo tolera, no porque estuviera bien**, que es
        # la clase de cosa que esta casa ya pagó dos veces.
        #
        #   proxy_ssl_server_name   sin esto nginx NO manda SNI. Hoy no importa;
        #                           el día que la API quede detrás de un balanceador
        #                           que enruta por SNI, el handshake falla.
        #   proxy_ssl_verify        sin esto aceptamos CUALQUIER certificado del
        #                           upstream. El tráfico va cifrado y sin autenticar,
        #                           que es la mitad de TLS.
        #
        # El nombre para el SNI y para la verificación sale solo del host de
        # `proxy_pass` — no hace falta una variable más.
        #
        # **Las dos son inertes con un upstream `http://`**, así que el modo local
        # —`API_ORIGIN=http://localhost:4010`— no cambia.
        #
        # **Si el upstream usa un certificado autofirmado**, esto lo rechaza y hay
        # que poner su CA en `proxy_ssl_trusted_certificate` o bajar `verify` a
        # `off` a propósito. Fallar es lo correcto: un certificado que no valida
        # es algo que alguien tiene que decidir, no algo que se acepte en silencio.
        proxy_ssl_server_name       on;
        proxy_ssl_verify            on;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_ssl_verify_depth      2;

        proxy_set_header   Host              ${DOLLAR}host;
        proxy_set_header   X-Real-IP         ${DOLLAR}remote_addr;
        proxy_set_header   X-Forwarded-For   ${DOLLAR}proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto ${DOLLAR}scheme;

        # ── EL CHAT ES SSE · Y ACÁ HAY UNA CORRECCIÓN MEDIDA ──────────────────
        #
        # `POST /config/chat` devuelve `text/event-stream` y el front lo lee como
        # stream con `getReader()` — no usa `EventSource` porque la pregunta va
        # en el cuerpo y `EventSource` sólo hace GET.
        #
        # **Acá decía que sin `proxy_buffering off` el chat se ve COLGADO y al
        # final vuelca todo junto. Se midió contra Cortex real y ES FALSO.**
        #
        #   buffering off  →  79 trozos repartidos en 20,87 s
        #   buffering on   → 119 trozos repartidos en 18,03 s
        #
        # Las dos veces llegó incremental. La respuesta entera son ~6-8 KB y
        # **entra en los buffers por default** —8 × 4k— y aun así nginx la
        # reenvía a medida que la lee, porque con el cliente siguiendo el ritmo
        # no espera a completarla.
        #
        # **Se deja en `off` igual, y la razón ahora es la correcta:** quita la
        # dependencia del tamaño de los buffers y del ritmo del cliente. Un
        # cliente lento o una respuesta más larga que los 32k sí haría que nginx
        # bufferee —incluso a disco—, y ahí el modo de falla descrito arriba
        # aparecería. **`off` lo vuelve imposible en vez de improbable.**
        #
        # Lo que NO se puede decir es que sea lo que hace andar el chat: anda sin
        # esto. Es una garantía, no un arreglo.
        proxy_buffering    off;
        proxy_cache        off;

        # El agente tarda. 90 s de lectura, que es más que cualquier respuesta
        # que hayamos medido y menos que dejar una conexión colgada para siempre.
        proxy_read_timeout 90s;
        proxy_send_timeout 90s;

        # Sin esto, un proxy intermedio puede bufferear igual aunque nginx no.
        add_header X-Accel-Buffering no always;
        include /etc/nginx/snippets/synapse-seguridad.conf;
    }

    # ── LOS ERRORES DEL NAVEGADOR · y las violaciones de la CSP ──────────────
    #
    # **nginx sólo lee el cuerpo si lo reenvía**, así que `${DOLLAR}request_body`
    # queda vacío con un `return 204` a secas. Se reenvía al `server` de abajo,
    # que contesta 204 y no registra nada: el cuerpo ya está leído y el log de
    # ESTA `location` lo escribe.
    #
    # 8 KB por error: un mensaje y las primeras líneas de la pila entran de
    # sobra, y más que eso es otra cosa.
    # Prefijo y no regex: con regex nginx no acepta `proxy_pass` con URI.
    location /_errores {
        limit_except POST { deny all; }
        limit_req zone=synapse_errores burst=30 nodelay;
        limit_req_status 429;
        client_max_body_size 8k;
        client_body_buffer_size 8k;
        client_body_in_single_buffer on;
        access_log /var/log/nginx/access.log synapse_errores;
        proxy_pass http://127.0.0.1:8099;
        proxy_set_header Host ${DOLLAR}host;
    }

    # ── LA SPA · try_files, y ES LA LÍNEA QUE MÁS IMPORTA ─────────────────────
    #
    # `AppProviders` monta `BrowserRouter`, no `HashRouter`. Sin esto, entrar
    # directo a `/admin` o **apretar F5 en cualquier pantalla que no sea `/`**
    # devuelve un 404 DEL SERVIDOR, no de la aplicación.
    #
    # **No se nota probando desde el login**, porque ahí la ruta es `/`. Se nota
    # cuando alguien comparte un enlace.
    location / {
        # `index.html` NO se cachea: es lo que apunta a los assets con hash, y
        # uno viejo referencia archivos que el deploy nuevo ya borró — la pantalla
        # queda en blanco sin un solo error visible.
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        include /etc/nginx/snippets/synapse-seguridad.conf;
        try_files ${DOLLAR}uri ${DOLLAR}uri/ /index.html;
    }
}

# ── EL QUE CONTESTA 204 AL REGISTRO DE ERRORES · sólo desde adentro ──────────
#
# **Un `server` aparte en loopback, y no una `location` con `allow`/`deny`.**
# Así estaba primero, y desde afuera contestaba 204 igual: `return` corre en
# la fase de reescritura, ANTES que la de acceso, así que el `deny` nunca se
# evaluaba. Medido el 2026-11-09. Escuchando en 127.0.0.1, y sin publicar el
# puerto, no hay forma de llegar desde fuera del contenedor.
server {
    listen      127.0.0.1:8099;
    access_log  off;
    return      204;
}
